# Host lists come from deploy/deploy.sh, e.g. API_HOSTS="api.ahiamarketplace.com, api.35-177-195-6.sslip.io".
# Caddy obtains Let's Encrypt certificates for every name automatically.
{$API_HOSTS} {
	encode gzip
	reverse_proxy api:4000
	# One line per request reaching the front door, so a phone whose requests never make it to
	# the API can still be traced (time, status, user agent). Query strings (search terms,
	# signed links) and the device id are dropped; Caddy already redacts Authorization.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers>X-Device-Id delete
				request>headers>Idempotency-Key delete
			}
		}
	}
}

{$ADMIN_HOSTS} {
	root * /srv/admin
	encode gzip
	try_files {path} /index.html
	file_server
}

{$APP_HOSTS} {
	root * /srv/web
	encode gzip
	try_files {path} /index.html
	file_server
}

# The bare domain serves the landing page (apps/landing); www redirects to it.
{$ROOT_HOSTS} {
	root * /srv/landing
	encode gzip
	header /assets/* Cache-Control "public, max-age=604800"
	# Latest Android test build (ANDROID_APK_URL in deploy/aws-test.env).
	redir /android {$ANDROID_APK_URL} 302
	file_server
}

{$WWW_HOSTS} {
	redir https://{$ROOT_HOST}{uri} permanent
}
