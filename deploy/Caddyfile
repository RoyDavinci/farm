# HOST_SUFFIX is e.g. 35-177-195-6.sslip.io; Caddy obtains Let's Encrypt certificates automatically.
api.{$HOST_SUFFIX} {
	encode gzip
	reverse_proxy api:4000
}

admin.{$HOST_SUFFIX} {
	root * /srv/admin
	encode gzip
	try_files {path} /index.html
	file_server
}

app.{$HOST_SUFFIX} {
	root * /srv/web
	encode gzip
	try_files {path} /index.html
	file_server
}
