# coturn: TURN relay for Ahia voice calls (deploy/deploy.sh fills in the values).
# Calls are relay-only, so neither caller learns the other's IP address.
listening-port=3478
# Relay only on the server's own interface (not Docker's internal networks).
relay-ip=__PRIVATE_IP__
external-ip=__PUBLIC_IP__/__PRIVATE_IP__
min-port=49160
max-port=49359
realm=ahia
# Credentials are time-limited HMACs issued by the API (the TURN REST API scheme).
use-auth-secret
static-auth-secret=__TURN_SECRET__
fingerprint
no-cli
no-tls
no-dtls
no-multicast-peers
stale-nonce=600
total-quota=400
user-quota=12
# Never relay into private networks or the cloud metadata service; allow only this host.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
allowed-peer-ip=__PRIVATE_IP__
log-file=stdout
simple-log
