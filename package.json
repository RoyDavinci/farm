{
  "name": "ahia",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,admin -c green,blue \"npm run dev -w @ahia/api\" \"npm run dev -w @ahia/admin\"",
    "dev:mobile": "npm run start -w @ahia/mobile",
    "dev:mobile:test": "EXPO_PUBLIC_API_URL=https://api.ahiamarketplace.com/v1 EXPO_PUBLIC_WEB_URL=https://app.ahiamarketplace.com npm run start -w @ahia/mobile",
    "db:migrate": "npm run db:migrate -w @ahia/api",
    "db:seed": "npm run db:seed -w @ahia/api",
    "db:studio": "npm run db:studio -w @ahia/api -- --port 5555",
    "db:studio:test": "./deploy/studio.sh",
    "logs:test": "./deploy/logs.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @ahia/api",
    "build": "npm run build -w @ahia/api && npm run build -w @ahia/admin",
    "check": "npm run typecheck && npm test && npm run build",
    "setup": "node scripts/setup.mjs",
    "dev:mobile:web": "npm run web -w @ahia/mobile",
    "preview:mobile": "node scripts/preview-mobile.mjs",
    "format": "prettier --write apps packages scripts *.json *.yaml .github/workflows/*.yml",
    "backup": "node scripts/backup.mjs",
    "worker": "npm run worker -w @ahia/api",
    "api:contract": "npm run openapi -w @ahia/api && openapi-typescript apps/api/openapi.json -o packages/shared/src/api-types.ts && prettier --write packages/shared/src/api-types.ts",
    "smoke": "node scripts/smoke.mjs",
    "acceptance:payments": "node scripts/payment-acceptance.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "^11.0.1"
    },
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
