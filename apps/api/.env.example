PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# PostgreSQL. `npm run setup` fills these in for the local Docker database.
DATABASE_URL=postgresql://farmers_market:CHANGE_ME@127.0.0.1:5432/farmers_market
# Local files (development email previews in DATA_DIR/mail).
DATA_DIR=.data/ahia
# Browser origins allowed by CORS (comma-separated, https:// only in production).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8095
# Number of proxy hops in front of the API (load balancer = 1) so rate limits see real client IPs.
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT=25
# Launch preset: core marketplace, booking and delivery only. Turns off the wallet (buyers pay each
# booking/delivery at the provider; refunds go back to the card), Local Status, promotions,
# shopping errands, parcels, voice, pre-orders and indoor market maps. Override any one with
# FEATURE_<NAME>=true|false: WALLET, LOCAL_STATUS, PROMOTIONS, SHOPPING, PARCELS, VOICE,
# PREORDERS, MARKET_MAPS.
PILOT_MODE=false
PAYMENTS_ENABLED=false
# Development only; simulated money, clearly labelled throughout the UI.
ALLOW_DEMO_FUNDING=true
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=http://localhost:8095
# Required for seed; never committed real secrets.
SEED_PASSWORD=

# OTP email: file mode writes private .eml previews in DATA_DIR/mail (development only).
MAIL_MODE=file
MAIL_FROM=Ahia <no-reply@ahia.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Set a random secret of at least 32 characters for production.
OTP_SECRET=
# Use your computer's LAN address here for photo URLs on physical phones.
# Public web app address, for "Open Ahia" buttons in emails (optional).
PUBLIC_WEB_URL=
PUBLIC_API_URL=http://localhost:4000
UPLOAD_DIR=.data/uploads

# Optional Mapbox public token. Never expose a secret sk.* token to clients.
MAPBOX_PUBLIC_TOKEN=
# Enable only when the Mapbox account supports storing geocoding results.
MAPBOX_PERMANENT_GEOCODING=false
PAYMENT_CALLBACK_URL=http://localhost:4000/api/v1/payments/return
FLUTTERWAVE_CALLBACK_URL=http://localhost:4000/api/v1/payments/return
PAYMENTS_FALLBACK_PROVIDER=FLUTTERWAVE
# hmac: flutterwave-signature; legacy: verif-hash (explicit opt-in only).
FLUTTERWAVE_WEBHOOK_MODE=hmac
STORAGE_PROVIDER=local
RECORDS_STORAGE_PROVIDER=local
S3_BUCKET=
RECORDS_S3_BUCKET=
AWS_REGION=us-east-1
S3_PREFIX=ahia
# Prefer an IAM role in production. If local S3 access is needed, use rotated scoped keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Reserved for a future identity workflow; not enabled by this build.
FLUTTERWAVE_BVN_ENABLED=false
FLUTTERWAVE_BVN_REDIRECT_URL=

# Seller/driver payouts. Production requires a random key of at least 32 characters; it encrypts
# stored bank account numbers. PAYOUT_PROVIDER picks paystack (default) or flutterwave.
PAYOUT_ENCRYPTION_KEY=
PAYOUT_PROVIDER=paystack
# Push notifications via Expo. EXPO_ACCESS_TOKEN is optional (enhanced push security).
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
# Set to false on the API when `npm run worker` runs as a separate deployment.
RUN_WORKERS=true
# error | warn | info | http | debug. Production logs are JSON lines on stdout.
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000
# npm run backup: where to keep archives, how long, and an optional off-site S3 bucket.
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
BACKUP_S3_BUCKET=

# Tests rebuild this database from the migrations; its name must end in _test.
TEST_DATABASE_URL=postgresql://farmers_market:CHANGE_ME@127.0.0.1:5432/farmers_market_test
DATABASE_POOL_SIZE=10
# Redis (shared rate limits + realtime across instances). `npm run setup` fills these in locally.
REDIS_URL=
TEST_REDIS_URL=

# Optional explicit executables for Local Status videos; defaults use PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Voice preview is enabled in simulation; native clients need rebuilding.
# Across mobile networks, configure your own STUN/TURN service before enabling live calling.
# Outside demo mode, calls stay off until a TURN relay is set: they never connect directly,
# so participants cannot see each other's network address.
VOICE_CALLS_ENABLED=false
VOICE_STUN_URL=
VOICE_TURN_URL=
VOICE_TURN_SECRET=
