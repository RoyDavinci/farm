{
  "name": "@zuru/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma migrate deploy && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/database/seed.ts",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.16.3",
    "prisma": "^7.10.1",
    "rate-limit-redis": "^6.0.2",
    "sharp": "^0.35.5",
    "winston": "^3.19.0",
    "ws": "^8.23.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^5.1.0"
  }
}
