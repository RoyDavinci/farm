model driver_ratings {
  id                                    String   @id
  delivery_id                           String   @unique
  buyer_id                              String
  driver_id                             String
  punctuality                           Int
  care                                  Int
  professionalism                       Int
  comment                               String   @default("")
  created_at                            DateTime @default(now()) @db.Timestamptz(6)
  users_driver_ratings_buyer_idTousers  User     @relation("driver_ratings_buyer_idTousers", fields: [buyer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deliveries                            Delivery @relation(fields: [delivery_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_driver_ratings_driver_idTousers User     @relation("driver_ratings_driver_idTousers", fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([driver_id], map: "driver_ratings_driver_idx")
}

model market_paths {
  id                                                      String           @id
  market_id                                               String
  from_id                                                 String
  to_id                                                   String
  metres                                                  Float
  instructions                                            String           @default("")
  accessible                                              Boolean          @default(true)
  active                                                  Boolean          @default(true)
  market_waypoints_market_paths_from_idTomarket_waypoints market_waypoints @relation("market_paths_from_idTomarket_waypoints", fields: [from_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  markets                                                 Market           @relation(fields: [market_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  market_waypoints_market_paths_to_idTomarket_waypoints   market_waypoints @relation("market_paths_to_idTomarket_waypoints", fields: [to_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([from_id, to_id])
}

model market_waypoints {
  id                                                  String         @id
  market_id                                           String
  label                                               String
  kind                                                String
  latitude                                            Float
  longitude                                           Float
  verified                                            Boolean        @default(false)
  active                                              Boolean        @default(true)
  updated_at                                          DateTime       @default(now()) @db.Timestamptz(6)
  market_paths_market_paths_from_idTomarket_waypoints market_paths[] @relation("market_paths_from_idTomarket_waypoints")
  market_paths_market_paths_to_idTomarket_waypoints   market_paths[] @relation("market_paths_to_idTomarket_waypoints")
  markets                                             Market         @relation(fields: [market_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([market_id], map: "market_waypoints_market_idx")
}

model marketplace_events {
  id         String   @id
  user_id    String
  kind       String
  listing_id String?
  category   String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  listings   Listing? @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "marketplace_events_created_idx")
  @@index([user_id, created_at], map: "marketplace_events_user_idx")
}

model marketplace_policies {
  id         Int      @id
  draft      Json     @default("{}")
  approved   Json     @default("{}")
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model preorder_interests {
  id          String    @id
  buyer_id    String
  listing_id  String
  quantity    Int
  status      String    @default("WAITING")
  booking_id  String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  notified_at DateTime? @db.Timestamptz(6)
  bookings    Booking?  @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       User      @relation(fields: [buyer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  listings    Listing   @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([buyer_id, listing_id])
}

model return_journeys {
  id                                       String    @id
  dispute_id                               String    @unique(map: "return_journeys_open_case_idx", where: raw("(status <> 'CANCELLED'::text)"))
  buyer_id                                 String
  seller_id                                String
  driver_id                                String?
  status                                   String    @default("ASSIGNED")
  pickup_address                           String
  pickup_latitude                          Float
  pickup_longitude                         Float
  dropoff_address                          String
  dropoff_latitude                         Float
  dropoff_longitude                        Float
  fee_kobo                                 Int
  driver_kobo                              Int
  payer_account                            String
  payer_id                                 String?
  pickup_pin                               String
  return_pin                               String
  pin_failures                             Int       @default(0)
  pin_locked_until                         DateTime? @db.Timestamptz(6)
  reason                                   String
  reviewed_by                              String
  created_at                               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime  @default(now()) @db.Timestamptz(6)
  users_return_journeys_buyer_idTousers    User      @relation("return_journeys_buyer_idTousers", fields: [buyer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  disputes                                 Dispute   @relation(fields: [dispute_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_return_journeys_driver_idTousers   User?     @relation("return_journeys_driver_idTousers", fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_return_journeys_reviewed_byTousers User      @relation("return_journeys_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_return_journeys_seller_idTousers   User      @relation("return_journeys_seller_idTousers", fields: [seller_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([driver_id, status], map: "return_journeys_driver_idx")
}

model ParcelJob {
  id                String      @id
  buyer_id          String
  driver_id         String
  vehicle_type      String
  description       String
  status            String      @default("REQUESTED")
  pickup_address    String
  pickup_latitude   Float
  pickup_longitude  Float
  dropoff_address   String
  dropoff_latitude  Float
  dropoff_longitude Float
  fare_kobo         Int
  commission_bps    Int
  distance_km       Float
  pricing           Json
  pickup_pin        String
  delivery_pin      String
  pin_failures      Int         @default(0)
  pin_locked_until  DateTime?   @db.Timestamptz(6)
  driver_latitude   Float?
  driver_longitude  Float?
  location_at       DateTime?   @db.Timestamptz(6)
  review_open       Boolean     @default(false)
  review_note       String?
  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  updated_at        DateTime    @default(now()) @db.Timestamptz(6)
  buyer             User        @relation("parcel_buyer", fields: [buyer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver            User        @relation("parcel_driver", fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle           VehicleType @relation(fields: [vehicle_type], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@index([driver_id, status], map: "parcel_jobs_driver_idx")
  @@index([buyer_id, created_at], map: "parcel_jobs_buyer_idx")
  @@map("parcel_jobs")
}

model VoiceCall {
  id              String        @id
  conversation_id String        @unique(map: "voice_calls_active_conversation_idx", where: raw("(status = ANY (ARRAY['RINGING'::text, 'ACCEPTED'::text]))"))
  caller_id       String
  callee_id       String
  status          String        @default("RINGING")
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  expires_at      DateTime      @default(dbgenerated("(now() + '00:02:00'::interval)")) @db.Timestamptz(6)
  conversation    Conversation  @relation(fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  caller          User          @relation("voice_caller", fields: [caller_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  callee          User          @relation("voice_callee", fields: [callee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signals         VoiceSignal[]

  @@map("voice_calls")
}

model VoiceSignal {
  id         String    @id
  call_id    String
  sender_id  String
  kind       String
  payload    Json
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  call       VoiceCall @relation(fields: [call_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender     User      @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([call_id, created_at], map: "voice_signals_call_idx")
  @@map("voice_signals")
}

model MarketRegion {
  code       String   @id
  country    String
  currency   String
  locale     String
  enabled    Boolean  @default(false)
  cities     Json     @default("[]")
  notes      String   @default("")
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("market_regions")
}

// Smart Planner and cart (migration 20261121160000_cart_and_planner). Foreign keys live in SQL;
// these models carry no Prisma relations because the API queries them with raw SQL.
model Plan {
  id          String    @id
  user_id     String
  title       String
  /// HOME, EVENT, FOOD, PERSONAL, OFFICE or CUSTOM.
  kind        String
  template    String?
  budget_kobo BigInt?
  people      Int?
  rooms       Int?
  /// BASIC, STANDARD or PREMIUM.
  tier        String    @default("STANDARD")
  target_date DateTime? @db.Date
  /// ACTIVE, PAUSED or COMPLETED.
  status      String    @default("ACTIVE")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, updated_at(sort: Desc)], map: "plans_user_idx")
  @@map("plans")
}

model PlanItem {
  id             String   @id
  plan_id        String
  section        String   @default("Items")
  name           String
  category       String?
  keywords       String   @default("")
  quantity       Float    @default(1)
  unit           String   @default("piece")
  /// Estimate for the whole line, never a live price.
  budget_kobo    BigInt   @default(0)
  /// ESSENTIAL, IMPORTANT or OPTIONAL.
  priority       String   @default("IMPORTANT")
  /// PLANNED, SAVED, PURCHASED, UNAVAILABLE, NOT_NEEDED or OWNED.
  status         String   @default("PLANNED")
  listing_id     String?
  variant_id     String?
  /// TEMPLATE, RECIPE or MANUAL.
  source         String   @default("MANUAL")
  ingredient_key String?
  allergens      String[] @default([])
  position       Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([plan_id, position], map: "plan_items_plan_idx")
  @@map("plan_items")
}

model PlanMeal {
  id         String   @id
  plan_id    String
  recipe     String
  day        Int      @default(1)
  /// BREAKFAST, LUNCH or DINNER.
  meal       String   @default("DINNER")
  servings   Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([plan_id, day], map: "plan_meals_plan_idx")
  @@map("plan_meals")
}

/// Sensitive: allergies and diet. Only the owner reads it; never shown to sellers.
model DietProfile {
  user_id      String    @id
  allergies    String[]  @default([])
  intolerances String[]  @default([])
  avoid        String[]  @default([])
  patterns     String[]  @default([])
  consented_at DateTime? @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@map("diet_profiles")
}

model CartItem {
  id           String   @id
  user_id      String
  listing_id   String
  variant_id   String
  quantity     Int
  plan_item_id String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, variant_id])
  @@index([user_id, created_at], map: "cart_items_user_idx")
  @@map("cart_items")
}

/// Buyer reports of missing or wrong allergen information; reviewed by staff.
model AllergenReport {
  id          String    @id
  reporter_id String
  listing_id  String?
  recipe      String?
  /// MISSING, INCORRECT, REACTION or OTHER.
  issue       String
  allergens   String[]  @default([])
  details     String
  /// OPEN, REVIEWING, RESOLVED or DISMISSED.
  status      String    @default("OPEN")
  resolution  String?
  reviewed_by String?
  reviewed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, created_at], map: "allergen_reports_status_idx")
  @@index([reporter_id, created_at(sort: Desc)], map: "allergen_reports_reporter_idx")
  @@map("allergen_reports")
}

// Revenue, verification and case management (migration 20261122120000). Raw-SQL tables; foreign
// keys live in SQL.
model VerificationEvent {
  id         String   @id
  seller_id  String
  status     String
  note       String   @default("")
  actor_id   String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([seller_id, created_at(sort: Desc)], map: "verification_events_seller_idx")
  @@map("verification_events")
}

model PromotionPackage {
  id         String   @id
  /// PRODUCT or SELLER.
  kind       String
  name       String
  days       Int
  price_kobo BigInt
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("promotion_packages")
}

model FeaturedSeller {
  id            String   @id
  seller_id     String
  package_id    String?
  days          Int
  fee_kobo      BigInt
  starts_at     DateTime @default(now()) @db.Timestamptz(6)
  ends_at       DateTime @db.Timestamptz(6)
  status        String   @default("ACTIVE")
  cancel_reason String?
  refund_kobo   BigInt   @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([status, ends_at], map: "featured_sellers_active_idx")
  @@map("featured_sellers")
}

model AdCampaign {
  id            String   @id
  advertiser    String
  contact_name  String   @default("")
  contact_phone String   @default("")
  contact_email String   @default("")
  title         String
  body          String   @default("")
  image_url     String?
  link_url      String?
  cta           String   @default("Learn more")
  states        String[] @default([])
  lgas          String[] @default([])
  categories    String[] @default([])
  starts_at     DateTime @db.Timestamptz(6)
  ends_at       DateTime @db.Timestamptz(6)
  price_kobo    BigInt
  paid_kobo     BigInt   @default(0)
  /// DRAFT, ACTIVE, PAUSED or ENDED.
  status        String   @default("DRAFT")
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  created_by    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([status, starts_at, ends_at], map: "ad_campaigns_live_idx")
  @@map("ad_campaigns")
}

model AdPayment {
  id          String   @id
  campaign_id String
  amount_kobo BigInt
  reference   String
  recorded_by String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("ad_payments")
}

model DeliveryPartner {
  id             String   @id
  name           String
  contact_name   String   @default("")
  phone          String   @default("")
  email          String   @default("")
  states         String[] @default([])
  commission_bps Int
  /// ACTIVE or PAUSED.
  status         String   @default("ACTIVE")
  notes          String   @default("")
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("delivery_partners")
}

model CaseNote {
  id         String   @id
  dispute_id String
  author_id  String?
  /// MESSAGE, INTERNAL, UPDATE or SYSTEM.
  kind       String
  body       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([dispute_id, created_at], map: "case_notes_dispute_idx")
  @@map("case_notes")
}
