{
  "expo": {
    "name": "Zuru",
    "slug": "zuru",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "zuru",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.zuru.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Allow microphone access only when you start or accept an in-app voice call."
      }
    },
    "android": {
      "package": "ng.zuru.app",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0954E",
        "monochromeImage": "./assets/adaptive-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Zuru",
      "shortName": "Zuru",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zuru to select product and receipt photos.",
          "cameraPermission": "Allow Zuru to take photos of products and receipts.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Zuru to find nearby sellers, set collection pins and share delivery location.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Allow location during active delivery work, including when the app is in the background. You can turn this off in Drive."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F0954E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Zuru to scan delivery handover codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F0954E"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
