{
  "expo": {
    "name": "Farmers Market",
    "slug": "farmers-market",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "farmersmarket",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "market.farmers.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "market.farmers.app",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#365b38"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Farmers Market",
      "shortName": "Farmers Market",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Farmers Market to select produce photos for your listings.",
          "cameraPermission": "Allow Farmers Market to take photos of your produce.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Farmers Market to find nearby produce or set your collection pin."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#365b38"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Farmers Market to scan delivery handover codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#365b38"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
